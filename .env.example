# UniHub · variables de entorno
# Copia este archivo como .env.local (para tu ordenador) o ponlas en Vercel (para la web).
# NUNCA subas .env.local a GitHub: ya está en .gitignore.
# Las que empiezan por NEXT_PUBLIC_ son públicas por diseño; el resto son SECRETAS (solo servidor).

# ─── App ─────────────────────────────────────────────────────────────────────
# Dirección donde corre la app (en local, http://localhost:3000; en Vercel, tu dominio).
APP_URL=http://localhost:3000
# Correos que pueden entrar en la web, separados por comas.
ALLOWED_EMAILS=tu-correo@ejemplo.com

# ─── Supabase (inicio de sesión y, en la web, la base de datos) ─────────────
# Project Settings → API. Estas dos son públicas: la clave publishable solo da lo que permitan las
# políticas de seguridad (RLS) de las migraciones.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clave secreta (Project Settings → API Keys → Secret keys, «sb_secret_…»). La usan la
# sincronización automática (cron) y la prueba de IA. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ─── Canvas LMS (secreto) ────────────────────────────────────────────────────
# Dirección de tu campus terminada en /api/v1.
CANVAS_BASE_URL=https://tu-universidad.instructure.com/api/v1
# Canvas → Cuenta → Configuración → «+ Nuevo token de acceso». Caduca: renuévalo cuando avise.
CANVAS_ACCESS_TOKEN=

# ─── IA (secreto, opcional) ──────────────────────────────────────────────────
# OpenAI: https://platform.openai.com → API keys. Sin clave, la IA queda desactivada
# (o se usa la prueba gratuita si la configuras más abajo).
OPENAI_API_KEY=
# Modelo por defecto: gpt-6.1-sol (mejor calidad) o gpt-6-luna (económico). Se puede cambiar en Ajustes.
OPENAI_MODEL=gpt-6.1-sol

# ─── Sincronización automática y avisos (secreto, opcional) ─────────────────
# Secreto que envía quien llama a /api/cron/sync: Authorization: Bearer <CRON_SECRET>
# Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Notificaciones push del navegador. Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ─── Contraseña de la universidad cifrada (secreto, opcional) ───────────────
# Para guardar tu contraseña del campus y copiarla con un clic (cifrada con AES-256-GCM).
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes o la cambias, la contraseña guardada deja de poder leerse (se vuelve a guardar).
CREDENTIALS_ENCRYPTION_KEY=

# ─── Prueba gratuita de IA (opcional, solo si compartes UniHub con más gente) ─
# En la WEB (Vercel): activa el intermediario que usa TU clave con un límite al mes por usuario.
UNIHUB_TRIAL_ENABLED=0
# Clave de un proyecto de OpenAI aparte con tope de gasto (si no, usa OPENAI_API_KEY).
TRIAL_OPENAI_API_KEY=
# Límite por usuario y mes en dólares (por defecto 0.5).
TRIAL_MONTHLY_USD=0.5
# En el PROGRAMA de escritorio (al compilarlo): dirección de tu web con el intermediario.
# Vacía = el programa no ofrece la prueba (cada usuario pone su clave).
NEXT_PUBLIC_UNIHUB_TRIAL_URL=
